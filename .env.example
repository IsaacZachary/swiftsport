# Copy to .env and fill in. Never commit .env. On the VPS: chmod 600 .env
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=swiftsport.co.ke,www.swiftsport.co.ke
CSRF_TRUSTED_ORIGINS=https://swiftsport.co.ke,https://www.swiftsport.co.ke

# Postgres container (docker-compose.yml). Use letters and digits only in the password.
POSTGRES_DB=swiftsport
POSTGRES_USER=swiftsport
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://swiftsport:change-me@db:5432/swiftsport
