[Unit]
Description=Swift Sport website (gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/swiftsport
EnvironmentFile=/srv/swiftsport/.env
ExecStart=/srv/swiftsport/.venv/bin/gunicorn swiftsport.wsgi:application --bind 127.0.0.1:8001 --workers 3 --timeout 60
Restart=always

[Install]
WantedBy=multi-user.target
